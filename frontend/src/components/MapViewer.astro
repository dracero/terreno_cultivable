---
---

<div class="map-wrapper glass-panel">
  <!-- Barra de Presets Rápidos -->
  <div class="presets-bar">
    <span class="presets-label">Entornos Test:</span>
    <div class="presets-buttons" id="presets-container">
      <button class="preset-btn active" data-id="pergamino_nucleo" data-lat="-33.9500" data-lon="-60.6200" data-name="Pergamino (Zona Núcleo Agrícola)">
        🌽 Pergamino (Agrícola)
      </button>
      <button class="preset-btn" data-id="rio_salado_ribera" data-lat="-35.6850" data-lon="-58.4550" data-name="Río Salado (Parcela Ribereña Fluvial)">
        🌊 Río Salado (Ribereño)
      </button>
      <button class="preset-btn" data-id="delta_parana_humedal" data-lat="-33.8900" data-lon="-58.8800" data-name="Delta del Paraná (Humedal Fluvial)">
        🦆 Delta Paraná (Humedal)
      </button>
      <button class="preset-btn" data-id="costa_chapadmalal" data-lat="-38.1550" data-lon="-57.6280" data-name="Chapadmalal (Costa y Acantilado Marino)">
        🏖️ Costa Chapadmalal
      </button>
      <button class="preset-btn" data-id="laguna_chascomus" data-lat="-35.6050" data-lon="-58.0250" data-name="Laguna de Chascomús (Espejo de Agua)">
        💧 Laguna Chascomús
      </button>
      <button class="preset-btn" data-id="dolores_bajos" data-lat="-36.3600" data-lon="-57.5800" data-name="Dolores (Bajos de Samborombón)">
        🌿 Dolores (Bajos)
      </button>
      <button class="preset-btn" data-id="tandil_serrana" data-lat="-37.3900" data-lon="-59.0500" data-name="Tandil (Piedemonte Agrícola)">
        ⛰️ Tandil (Piedemonte)
      </button>
      <button class="preset-btn" data-id="sierra_ventana_cordon" data-lat="-38.1450" data-lon="-61.9750" data-name="Sierra de la Ventana (Cordón Serrano)">
        🏔️ Sierra de la Ventana (Roca)
      </button>
    </div>
  </div>

  <!-- Barra de Control de Coordenadas, Superficie y Búsqueda -->
  <div class="controls-bar">
    <div class="input-group">
      <label for="input-name">Nombre del Lote</label>
      <input type="text" id="input-name" value="Pergamino (Zona Núcleo Agrícola)" placeholder="Identificación..." />
    </div>

    <div class="input-group small">
      <label for="input-lat">Latitud</label>
      <input type="number" id="input-lat" step="0.0001" value="-33.9500" />
    </div>

    <div class="input-group small">
      <label for="input-lon">Longitud</label>
      <input type="number" id="input-lon" step="0.0001" value="-60.6200" />
    </div>

    <div class="input-group xsmall">
      <label for="input-area">Superficie (ha)</label>
      <input type="number" id="input-area" min="10" max="5000" step="10" value="120" />
    </div>

    <button id="btn-analyze" class="btn btn-primary">
      <span class="btn-icon">⚡</span>
      <span class="btn-text">Analizar Terreno</span>
    </button>
  </div>

  <!-- Barra de Herramientas Topográficas del Mapa -->
  <div class="topo-toolbar">
    <div class="mode-switch-group">
      <span class="toolbar-label">Modo Interacción:</span>
      <button type="button" class="mode-btn active" id="mode-audit-btn" title="Hacer click en el mapa para auditar una nueva coordenada">
        📍 Auditar Lote
      </button>
      <button type="button" class="mode-btn" id="mode-transect-btn" title="Hacer click en dos puntos (A y B) dentro del mapa para trazar un corte topográfico a medida">
        📏 Trazar Corte Topográfico (A → B)
      </button>
    </div>

    <div class="topo-quick-stats" id="map-topo-summary">
      <span class="quick-stat">Entorno: <strong id="stat-env-label">--</strong></span>
      <span class="quick-stat">Agua a: <strong id="stat-water-dist">--</strong></span>
      <span class="quick-stat">Equidistancia: <strong id="stat-contour-int">-- m</strong></span>
      <span class="quick-stat">Desnivel ΔH: <strong id="stat-relief-amp">-- m</strong></span>
      <span class="quick-stat">Pendiente: <strong id="stat-slope-pct">--%</strong></span>
    </div>
  </div>

  <div class="location-telemetry-bar" id="location-telemetry-bar">
    <span class="loc-badge">📍 OSM:</span>
    <span class="loc-text" id="stat-location-label">Ubicación geoespacial pendiente...</span>
  </div>

  <!-- Contenedor del Mapa Leaflet -->
  <div class="map-viewport-container">
    <div id="leaflet-map"></div>

    <!-- Controles flotantes sobre el mapa -->
    <div class="map-overlay-controls">
      <div class="layer-toggle-box glass-panel">
        <span class="toggle-title">Capas Topográficas (DEM Local):</span>
        <label class="toggle-item">
          <input type="checkbox" id="layer-contours" checked />
          <span>〰️ Curvas de Nivel (Isolíneas)</span>
        </label>
        <label class="toggle-item">
          <input type="checkbox" id="layer-flow" checked />
          <span>➡️ Vectores Escurrimiento D8</span>
        </label>
        <label class="toggle-item">
          <input type="checkbox" id="layer-water-mask" checked />
          <span>🌊 Máscara Agua / Río / Costa</span>
        </label>
        <label class="toggle-item">
          <input type="checkbox" id="layer-zones" />
          <span>🗺️ Zonificación por Ambientes</span>
        </label>
        <label class="toggle-item">
          <input type="checkbox" id="layer-transect" checked />
          <span>📐 Línea de Corte Activa</span>
        </label>

        <div class="toggle-divider"></div>
        <span class="toggle-title">Capas Satelitales STAC:</span>
        <label class="toggle-item">
          <input type="checkbox" id="layer-jrc" checked />
          <span>💧 JRC Agua 35 años</span>
        </label>
        <label class="toggle-item">
          <input type="checkbox" id="layer-dem" />
          <span>⛰️ Copernicus DEM Regional</span>
        </label>
      </div>

      <!-- Leyenda Topográfica y de Ambientes -->
      <div class="map-legend glass-panel">
        <span class="legend-title">Ambientes Detectados</span>
        <div class="env-legend-items" id="dynamic-zone-legend">
          <div class="env-dot-row"><span class="dot" style="background:#10b981;"></span><span>Zona Alta / Bien Drenada</span></div>
          <div class="env-dot-row"><span class="dot" style="background:#3b82f6;"></span><span>Media Loma / Transición</span></div>
          <div class="env-dot-row"><span class="dot" style="background:#f59e0b;"></span><span>Bajo / Humedal</span></div>
          <div class="env-dot-row"><span class="dot" style="background:#0284c7;"></span><span>Agua / Cauce / Costa</span></div>
        </div>
        <div class="toggle-divider"></div>
        <span class="legend-title">Recurrencia JRC (%)</span>
        <div class="legend-bar">
          <span class="color-stop stop-0"></span>
          <span class="color-stop stop-25"></span>
          <span class="color-stop stop-50"></span>
          <span class="color-stop stop-75"></span>
          <span class="color-stop stop-100"></span>
        </div>
        <div class="legend-labels">
          <span>0% Seco</span>
          <span>50%</span>
          <span>100% Agua</span>
        </div>
      </div>
    </div>

    <!-- Indicador dinámico de click en mapa -->
    <div class="map-hint" id="map-hint-banner">
      📍 Modo Auditoría: Haz click en cualquier punto del mapa para analizar su topografía y riesgo hídrico
    </div>
  </div>
</div>

<style>
  .map-wrapper {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 16px;
    height: 100%;
    min-height: 620px;
    position: relative;
    overflow: hidden;
  }

  .presets-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    overflow-x: auto;
    padding-bottom: 2px;
  }

  .presets-label {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 600;
    white-space: nowrap;
    text-transform: uppercase;
  }

  .presets-buttons {
    display: flex;
    gap: 6px;
    flex-wrap: nowrap;
  }

  .preset-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--text-main);
    padding: 5px 11px;
    border-radius: 8px;
    font-size: 0.76rem;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
    font-family: var(--font-body);
  }

  .preset-btn:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .preset-btn.active {
    background: rgba(16, 185, 129, 0.2);
    border-color: var(--color-agri);
    color: var(--color-agri-light);
    box-shadow: 0 0 12px rgba(16, 185, 129, 0.25);
  }

  .controls-bar {
    display: flex;
    align-items: flex-end;
    gap: 10px;
    background: rgba(10, 15, 29, 0.6);
    padding: 10px 14px;
    border-radius: 12px;
    border: 1px solid var(--border-subtle);
    flex-wrap: wrap;
  }

  .input-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1.2;
    min-width: 130px;
  }

  .input-group.small {
    flex: 0.65;
    min-width: 92px;
  }

  .input-group.xsmall {
    flex: 0.5;
    min-width: 82px;
  }

  .input-group label {
    font-size: 0.7rem;
    color: var(--text-muted);
    font-weight: 600;
    text-transform: uppercase;
  }

  .input-group input {
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    padding: 7px 10px;
    color: #ffffff;
    font-size: 0.83rem;
    font-family: var(--font-mono);
    outline: none;
    transition: border-color 0.2s ease;
  }

  .input-group input:focus {
    border-color: var(--color-hydro);
    box-shadow: 0 0 0 2px rgba(6, 182, 212, 0.2);
  }

  #btn-analyze {
    height: 36px;
    white-space: nowrap;
    padding: 0 16px;
  }

  .topo-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    padding: 7px 12px;
    background: rgba(6, 182, 212, 0.07);
    border: 1px solid rgba(6, 182, 212, 0.2);
    border-radius: 10px;
    flex-wrap: wrap;
  }

  .mode-switch-group {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .toolbar-label {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-hydro-light);
    text-transform: uppercase;
    margin-right: 4px;
  }

  .mode-btn {
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--text-muted);
    padding: 4px 10px;
    border-radius: 7px;
    font-size: 0.74rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: var(--font-body);
  }

  .mode-btn:hover {
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.25);
  }

  .mode-btn.active {
    background: rgba(6, 182, 212, 0.22);
    border-color: var(--color-hydro);
    color: #ffffff;
    box-shadow: 0 0 10px rgba(6, 182, 212, 0.25);
  }

  .topo-quick-stats {
    display: flex;
    gap: 12px;
    font-size: 0.73rem;
    color: var(--text-muted);
  }

  .quick-stat strong {
    color: var(--color-hydro-light);
    font-family: var(--font-mono);
  }

  .map-viewport-container {
    flex: 1;
    min-height: 460px;
    border-radius: 12px;
    overflow: hidden;
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  #leaflet-map {
    width: 100%;
    height: 100%;
    min-height: 460px;
    background: #090e17;
  }

  .map-overlay-controls {
    position: absolute;
    top: 12px;
    right: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    z-index: 1000;
    pointer-events: none;
    max-width: 215px;
  }

  .layer-toggle-box, .map-legend {
    pointer-events: auto;
    padding: 9px 12px;
    background: rgba(10, 15, 29, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 10px;
    font-size: 0.73rem;
  }

  .toggle-divider {
    height: 1px;
    background: rgba(255, 255, 255, 0.08);
    margin: 7px 0;
  }

  .toggle-title, .legend-title {
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 4px;
    display: block;
    font-family: var(--font-heading);
    font-size: 0.74rem;
  }

  .toggle-item {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--text-muted);
    cursor: pointer;
    margin-top: 4px;
    font-size: 0.72rem;
  }

  .toggle-item:hover {
    color: #ffffff;
  }

  .toggle-item input {
    accent-color: var(--color-hydro);
    cursor: pointer;
  }

  .env-legend-items {
    display: flex;
    flex-direction: column;
    gap: 3px;
    margin-top: 4px;
  }

  .env-dot-row {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.69rem;
    color: var(--text-muted);
  }

  .env-dot-row .dot {
    width: 9px;
    height: 9px;
    border-radius: 3px;
    flex-shrink: 0;
  }

  .legend-bar {
    height: 7px;
    width: 100%;
    border-radius: 4px;
    background: linear-gradient(to right, #00ffff, #0088ff, #0000ff, #5500aa, #ff0055);
    margin: 4px 0;
  }

  .legend-labels {
    display: flex;
    justify-content: space-between;
    font-size: 0.64rem;
    color: var(--text-dim);
  }

  .map-hint {
    position: absolute;
    bottom: 12px;
    left: 12px;
    background: rgba(10, 15, 29, 0.88);
    backdrop-filter: var(--blur-glass);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 0.74rem;
    color: var(--text-muted);
    z-index: 1000;
    pointer-events: none;
  }

  .location-telemetry-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 5px 12px;
    background: rgba(15, 23, 42, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    font-size: 0.73rem;
    color: var(--text-muted);
  }

  .loc-badge {
    font-weight: 700;
    color: var(--color-agri-light);
    white-space: nowrap;
  }

  .loc-text {
    color: #e2e8f0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
